# PgVault local development configuration.
# Copy this file to `.env` and adjust values for your PostgreSQL instance.

PGHOST=localhost
PGPORT=5432
PGDATABASE=fintechdb
PGUSER=pgvault_readonly
PGPASSWORD=pgvault_password
PGSSLMODE=disable

# Optional: takes precedence over PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.
# DATABASE_URL=postgresql://pgvault_readonly:pgvault_password@localhost:5432/fintechdb

# Future PII/content scanners can use this limit when they sample data.
PGVAULT_SAMPLE_LIMIT=100

# Timeout applied to catalog and scanner queries.
PGVAULT_QUERY_TIMEOUT_SECONDS=10
